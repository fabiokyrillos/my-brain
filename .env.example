# Browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only provider configuration. Never prefix with NEXT_PUBLIC_.
#
# THERE IS NO PROJECT-WIDE OPENAI KEY. `OPENAI_API_KEY` used to live here and is
# deliberately gone: BYOK.3 removed the last Node read, BYOK.4 removed the last
# Deno read, and the deployed Edge Function secret was unset at the cutover. A
# census over `src`, `supabase/functions`, `scripts`, `e2e` and `.github` found
# zero remaining consumers, so the name was removed rather than kept as a
# contract nothing honours.
#
# `src/lib/byok/project-key-guard.test.ts` now fails the build if the name
# reappears anywhere outside the two guards that assert its absence — including
# in this file. Every AI call resolves the *acting user's own* stored credential
# and a call site that forgot one fails at `tsc` rather than falling back.
#
# This is spelled out because the failure mode the initiative guards against was
# never somebody deciding to re-add a fallback. It was somebody needing a key at
# 3am, finding the name here, and wiring it into "one path that just needs to
# work". There is no name here to find.
#
# Model ids are public and carry no capability, so these stay. Only names an
# implementation actually reads are listed: the Node provider reads the first
# two, the Deno attachment handler reads the third, and each has a code default.
OPENAI_EXTRACTION_MODEL=
OPENAI_EMBEDDING_MODEL=
OPENAI_FILE_MODEL=

# Server-only administrative access for controlled workers only.
SUPABASE_SERVICE_ROLE_KEY=

# BYOK — bring your own key (see docs/reports/BYOK_G03_MASTER_KEY_PROCEDURE.md).
# Both must be 32 random bytes, base64. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Distinct per environment; never committed; an absent or malformed value fails
# the process to start rather than falling back.
#
# THE NEXT.JS AND EDGE FUNCTION RUNTIMES OF ONE ENVIRONMENT MUST HOLD THE SAME
# THREE VALUES, BYTE FOR BYTE. A credential is sealed under whichever
# `BYOK_MASTER_KEY` the saving process held and can be opened under no other, so
# a mismatch is silent at save time and terminal at execution time — Settings
# reports "configured" and every asynchronous job then fails
# `credential_unreadable` forever. That is not hypothetical; it is what the first
# BYOK deployment did. Check both sides before configuring any credential:
#
#   npm run byok:verify-runtime
BYOK_MASTER_KEY=
BYOK_FINGERPRINT_PEPPER=
# Third independent secret (ADR-070). HMAC key for credential_validation_attempts
# .ip_hash. Never the master key, never the fingerprint pepper: one compromise
# must not yield two capabilities.
BYOK_RATE_LIMIT_PEPPER=

# The bounded two-key master-key rotation window (BYOK-ROTATION). All three are
# ABSENT in normal operation and exist only while a rotation is in flight.
#
# `key_version` on each credential row says which key sealed it, so the reader
# selects ONE key and never trials a second — a fallback would be a decryption
# oracle. The previous key is READ-ONLY: every new write uses the current key.
#
# Setting any of these without the others is refused at startup, as is a window
# longer than 30 days. Drive the re-encryption with:
#
#   node scripts/byok-rotate-master-key.mjs --status
#   node scripts/byok-rotate-master-key.mjs --apply
#
# and remove the previous key only once that reports `remaining: 0`. Procedure
# and rollback limits: docs/reports/BYOK_INCIDENT_RUNBOOK.md §2a.
BYOK_MASTER_KEY_VERSION=
BYOK_PREVIOUS_MASTER_KEY=
BYOK_PREVIOUS_MASTER_KEY_EXPIRES_AT=

# Opt-in BYOK validation lane only (G-0.4). A dedicated OpenAI project,
# restricted models, lowest practical rate limits, USD 2 monthly budget ALERT
# (a soft alert, not a hard cap). Never used by normal product runtime, and
# never a substitute for a user's own configured credential.
BYOK_VALIDATION_OPENAI_API_KEY=
