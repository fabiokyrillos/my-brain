# Browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only provider configuration. Never prefix with NEXT_PUBLIC_.
#
# OPENAI_API_KEY IS READ BY NOTHING THAT SHIPS.
#
# Since BYOK.3 (Node) and BYOK.4 (Deno) no product path consults it: every AI
# call resolves the *acting user's own* stored credential, and a call site that
# forgot one fails at `tsc` rather than falling back. The name survives here for
# local development and for the remote smokes only, and
# `src/lib/byok/project-key-guard.test.ts` fails the build if any deployed module
# in either runtime reaches for it.
#
# It is spelled out because the failure mode this whole initiative guards against
# is not somebody deciding to re-add a fallback — it is somebody needing a key at
# 3am, finding this line, and wiring it into "one path that just needs to work".
# BYOK.5 removes it from the deployed Edge Function and application runtimes.
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=
OPENAI_CHAT_MODEL=
OPENAI_REASONING_MODEL=
OPENAI_EMBEDDING_MODEL=

# Server-only administrative access for controlled workers only.
SUPABASE_SERVICE_ROLE_KEY=

# BYOK — bring your own key (see docs/reports/BYOK_G03_MASTER_KEY_PROCEDURE.md).
# Both must be 32 random bytes, base64. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Distinct per environment; never committed; an absent or malformed value fails
# the process to start rather than falling back.
BYOK_MASTER_KEY=
BYOK_FINGERPRINT_PEPPER=
# Third independent secret (ADR-070). HMAC key for credential_validation_attempts
# .ip_hash. Never the master key, never the fingerprint pepper: one compromise
# must not yield two capabilities.
BYOK_RATE_LIMIT_PEPPER=

# Opt-in BYOK validation lane only (G-0.4). Deliberately NOT OPENAI_API_KEY, so
# the lane cannot be satisfied by the project key. A dedicated OpenAI project,
# restricted models, lowest practical rate limits, USD 2 monthly budget ALERT
# (a soft alert, not a hard cap). Never used by normal product runtime.
BYOK_VALIDATION_OPENAI_API_KEY=
