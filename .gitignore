# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/playwright-results.json

# next.js
/.next/
/out/
/.worktrees/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# deno
# The Edge Function gate runs with --no-lock: package-lock.json stays the single
# source of dependency truth, and `npm:@supabase/supabase-js@2` resolves in CI
# the same way the deployed function resolves it. A stray lock from a local
# `deno test` must not dirty the tree.
deno.lock
supabase/functions/**/deno.lock
# `--node-modules-dir=auto` would materialize one of these inside a function
# directory, where `supabase functions deploy` would bundle it. CI uses `none`.
supabase/functions/**/node_modules
